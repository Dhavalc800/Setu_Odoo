<odoo>
    <record id="dispo_lead_type_tree" model="ir.ui.view">
        <field name="name">dispo.lead.type.tree</field>
        <field name="model">dispo.lead.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="dispo_lead_type_form" model="ir.ui.view">
        <field name="name">dispo.lead.type.form</field>
        <field name="model">dispo.lead.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dispo_lead_type" model="ir.actions.act_window">
        <field name="name">Dispo Lead Type</field>
        <field name="res_model">dispo.lead.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No CSV Lead Status Found!
            </p>
        </field>
    </record>

</odoo>
